
# Brain Trust master upgrade
# Passwordless onboarding
RESEND_API_KEY=
BRAINTRUST_EMAIL_FROM=
BRAINTRUST_SESSION_SECRET=

# Relay bridge (web -> trusted IRC relay)
BRAINTRUST_RELAY_STATUS_URL=
BRAINTRUST_RELAY_PM_URL=
BRAINTRUST_RELAY_TOKEN=

# Legacy PrincessGPT tools on relay host
BRAINTRUST_CATFISH_CMD=
